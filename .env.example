# LLM provider configuration
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=qwen3-max
LLM_TEMPERATURE=1.2

# Backward-compatible alias used by older local .env files.
DASHSCOPE_API_KEY=your_dashscope_api_key

# Search configuration
SEARCH_API=tavily
TAVILY_API_KEY=your_tavily_api_key

# Runtime limits and optional tools
AGENT_RECURSION_LIMIT=25
ENABLE_PYTHON_REPL=false

# Volcengine TTS configuration
VOLCENGINE_TTS_APPID=your_volcengine_tts_appid
VOLCENGINE_TTS_ACCESS_TOKEN=your_volcengine_tts_access_token
VOLCENGINE_TTS_CLUSTER=volcano_tts
VOLCENGINE_TTS_VOICE_TYPE=BV700_V2_streaming
VOLCENGINE_TTS_HOST=openspeech.bytedance.com
VOLCENGINE_TTS_API_URL=https://openspeech.bytedance.com/api/v1/tts
